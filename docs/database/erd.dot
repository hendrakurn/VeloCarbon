digraph VeloCarbon {
graph [rankdir=LR, splines=polyline, nodesep=0.4, ranksep=0.9, pad=0.3, bgcolor="#ffffff", fontname="Segoe UI", labelloc=t, fontsize=22, fontcolor="#102a43", compound=true, newrank=true];
node [shape=plain, fontname="Segoe UI", fontsize=9];
edge [color="#617d98", penwidth=1.1, arrowsize=0.65, fontname="Segoe UI", fontsize=8, fontcolor="#334e68"];
subgraph cluster_user_profile { label="Profil & kendaraan"; fontsize=13; fontname="Segoe UI"; fontcolor="#334e68"; style="rounded,filled"; color="#d9e2ec"; fillcolor="#f8fafc"; margin=14;
user_profile [label=< <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD ALIGN="LEFT" BGCOLOR="#0f766e"><FONT COLOR="white" POINT-SIZE="11"><B>user_profile</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#0f766e"><B>PK</B>&nbsp;id</FONT> <FONT COLOR="#829ab1" POINT-SIZE="8">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#243b53">name</FONT> <FONT COLOR="#829ab1" POINT-SIZE="8">VARCHAR(100)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#243b53">unit_preference</FONT> <FONT COLOR="#829ab1" POINT-SIZE="8">VARCHAR(10)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#243b53">created_at</FONT> <FONT COLOR="#829ab1" POINT-SIZE="8">TIMESTAMPTZ</FONT></TD></TR></TABLE> >];
vehicle [label=< <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD ALIGN="LEFT" BGCOLOR="#0f766e"><FONT COLOR="white" POINT-SIZE="11"><B>vehicle</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#0f766e"><B>PK</B>&nbsp;id</FONT> <FONT COLOR="#829ab1" POINT-SIZE="8">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#0f766e"><B>FK</B>&nbsp;user_profile_id</FONT> <FONT COLOR="#829ab1" POINT-SIZE="8">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#243b53">name</FONT> <FONT COLOR="#829ab1" POINT-SIZE="8">VARCHAR(100)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#243b53">vehicle_type</FONT> <FONT COLOR="#829ab1" POINT-SIZE="8">VARCHAR(16)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#243b53">fuel_type</FONT> <FONT COLOR="#829ab1" POINT-SIZE="8">VARCHAR(10)</FONT></TD></TR></TABLE> >];
vehicle_monthly_input [label=< <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD ALIGN="LEFT" BGCOLOR="#0f766e"><FONT COLOR="white" POINT-SIZE="11"><B>vehicle_monthly_input</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#0f766e"><B>PK</B>&nbsp;id</FONT> <FONT COLOR="#829ab1" POINT-SIZE="8">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#0f766e"><B>FK</B>&nbsp;vehicle_id</FONT> <FONT COLOR="#829ab1" POINT-SIZE="8">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#243b53">month</FONT> <FONT COLOR="#829ab1" POINT-SIZE="8">DATE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#243b53">method</FONT> <FONT COLOR="#829ab1" POINT-SIZE="8">VARCHAR(16)</FONT></TD></TR></TABLE> >];
}
subgraph cluster_activity_record { label="Aktivitas & detail"; fontsize=13; fontname="Segoe UI"; fontcolor="#334e68"; style="rounded,filled"; color="#d9e2ec"; fillcolor="#f8fafc"; margin=14;
activity_record [label=< <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD ALIGN="LEFT" BGCOLOR="#0f766e"><FONT COLOR="white" POINT-SIZE="11"><B>activity_record</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#0f766e"><B>PK</B>&nbsp;id</FONT> <FONT COLOR="#829ab1" POINT-SIZE="8">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#0f766e"><B>FK</B>&nbsp;user_profile_id</FONT> <FONT COLOR="#829ab1" POINT-SIZE="8">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#243b53">name</FONT> <FONT COLOR="#829ab1" POINT-SIZE="8">VARCHAR(100)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#243b53">activity_type</FONT> <FONT COLOR="#829ab1" POINT-SIZE="8">VARCHAR(16)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#243b53">unit</FONT> <FONT COLOR="#829ab1" POINT-SIZE="8">VARCHAR(10)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#243b53">activity_date</FONT> <FONT COLOR="#829ab1" POINT-SIZE="8">DATE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#243b53">created_at</FONT> <FONT COLOR="#829ab1" POINT-SIZE="8">TIMESTAMPTZ</FONT></TD></TR></TABLE> >];
mobility_activity [label=< <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD ALIGN="LEFT" BGCOLOR="#0f766e"><FONT COLOR="white" POINT-SIZE="11"><B>mobility_activity</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#0f766e"><B>PK</B>&nbsp;id</FONT> <FONT COLOR="#829ab1" POINT-SIZE="8">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#0f766e"><B>FK</B>&nbsp;vehicle_id</FONT> <FONT COLOR="#829ab1" POINT-SIZE="8">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#243b53">transport_mode</FONT> <FONT COLOR="#829ab1" POINT-SIZE="8">VARCHAR(16)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#243b53">distance_km</FONT> <FONT COLOR="#829ab1" POINT-SIZE="8">NUMERIC(12,3)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#243b53">frequency</FONT> <FONT COLOR="#829ab1" POINT-SIZE="8">INTEGER</FONT></TD></TR></TABLE> >];
fuel_purchase_activity [label=< <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD ALIGN="LEFT" BGCOLOR="#0f766e"><FONT COLOR="white" POINT-SIZE="11"><B>fuel_purchase_activity</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#0f766e"><B>PK</B>&nbsp;id</FONT> <FONT COLOR="#829ab1" POINT-SIZE="8">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#0f766e"><B>FK</B>&nbsp;vehicle_id</FONT> <FONT COLOR="#829ab1" POINT-SIZE="8">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#243b53">fuel_type</FONT> <FONT COLOR="#829ab1" POINT-SIZE="8">VARCHAR(10)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#243b53">liters_purchased</FONT> <FONT COLOR="#829ab1" POINT-SIZE="8">NUMERIC(12,3)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#243b53">total_cost</FONT> <FONT COLOR="#829ab1" POINT-SIZE="8">NUMERIC(14,2)</FONT></TD></TR></TABLE> >];
electricity_usage [label=< <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD ALIGN="LEFT" BGCOLOR="#0f766e"><FONT COLOR="white" POINT-SIZE="11"><B>electricity_usage</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#0f766e"><B>PK</B>&nbsp;id</FONT> <FONT COLOR="#829ab1" POINT-SIZE="8">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#243b53">input_method</FONT> <FONT COLOR="#829ab1" POINT-SIZE="8">VARCHAR(16)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#243b53">usage_kwh</FONT> <FONT COLOR="#829ab1" POINT-SIZE="8">NUMERIC(12,3)</FONT></TD></TR></TABLE> >];
appliance_usage [label=< <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD ALIGN="LEFT" BGCOLOR="#0f766e"><FONT COLOR="white" POINT-SIZE="11"><B>appliance_usage</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#0f766e"><B>PK</B>&nbsp;id</FONT> <FONT COLOR="#829ab1" POINT-SIZE="8">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#0f766e"><B>FK</B>&nbsp;electricity_usage_id</FONT> <FONT COLOR="#829ab1" POINT-SIZE="8">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#243b53">name</FONT> <FONT COLOR="#829ab1" POINT-SIZE="8">VARCHAR(100)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#243b53">power_watt</FONT> <FONT COLOR="#829ab1" POINT-SIZE="8">NUMERIC(9,3)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#243b53">quantity</FONT> <FONT COLOR="#829ab1" POINT-SIZE="8">SMALLINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#243b53">hours_per_day</FONT> <FONT COLOR="#829ab1" POINT-SIZE="8">NUMERIC(4,2)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#243b53">days_used</FONT> <FONT COLOR="#829ab1" POINT-SIZE="8">SMALLINT</FONT></TD></TR></TABLE> >];
}
subgraph cluster_emission_factor { label="Faktor & perhitungan"; fontsize=13; fontname="Segoe UI"; fontcolor="#334e68"; style="rounded,filled"; color="#d9e2ec"; fillcolor="#f8fafc"; margin=14;
emission_factor [label=< <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD ALIGN="LEFT" BGCOLOR="#0f766e"><FONT COLOR="white" POINT-SIZE="11"><B>emission_factor</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#0f766e"><B>PK</B>&nbsp;id</FONT> <FONT COLOR="#829ab1" POINT-SIZE="8">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#243b53">category</FONT> <FONT COLOR="#829ab1" POINT-SIZE="8">VARCHAR(16)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#243b53">factor_key</FONT> <FONT COLOR="#829ab1" POINT-SIZE="8">VARCHAR(16)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#243b53">value</FONT> <FONT COLOR="#829ab1" POINT-SIZE="8">NUMERIC(18,9)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#243b53">unit</FONT> <FONT COLOR="#829ab1" POINT-SIZE="8">VARCHAR(10)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#243b53">source</FONT> <FONT COLOR="#829ab1" POINT-SIZE="8">TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#243b53">version</FONT> <FONT COLOR="#829ab1" POINT-SIZE="8">VARCHAR(30)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#243b53">valid_from</FONT> <FONT COLOR="#829ab1" POINT-SIZE="8">DATE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#243b53">valid_until</FONT> <FONT COLOR="#829ab1" POINT-SIZE="8">DATE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#243b53">is_active</FONT> <FONT COLOR="#829ab1" POINT-SIZE="8">BOOLEAN</FONT></TD></TR></TABLE> >];
emission_calculation [label=< <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD ALIGN="LEFT" BGCOLOR="#0f766e"><FONT COLOR="white" POINT-SIZE="11"><B>emission_calculation</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#0f766e"><B>PK</B>&nbsp;id</FONT> <FONT COLOR="#829ab1" POINT-SIZE="8">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#0f766e"><B>FK</B>&nbsp;activity_record_id</FONT> <FONT COLOR="#829ab1" POINT-SIZE="8">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#0f766e"><B>FK</B>&nbsp;emission_factor_id</FONT> <FONT COLOR="#829ab1" POINT-SIZE="8">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#243b53">activity_value</FONT> <FONT COLOR="#829ab1" POINT-SIZE="8">NUMERIC(24,9)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#243b53">result_kg_co2e</FONT> <FONT COLOR="#829ab1" POINT-SIZE="8">NUMERIC(24,6)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#243b53">calculated_at</FONT> <FONT COLOR="#829ab1" POINT-SIZE="8">TIMESTAMPTZ</FONT></TD></TR></TABLE> >];
}
subgraph cluster_scenario { label="Simulasi & saran"; fontsize=13; fontname="Segoe UI"; fontcolor="#334e68"; style="rounded,filled"; color="#d9e2ec"; fillcolor="#f8fafc"; margin=14;
scenario [label=< <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD ALIGN="LEFT" BGCOLOR="#0f766e"><FONT COLOR="white" POINT-SIZE="11"><B>scenario</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#0f766e"><B>PK</B>&nbsp;id</FONT> <FONT COLOR="#829ab1" POINT-SIZE="8">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#0f766e"><B>FK</B>&nbsp;user_profile_id</FONT> <FONT COLOR="#829ab1" POINT-SIZE="8">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#243b53">name</FONT> <FONT COLOR="#829ab1" POINT-SIZE="8">VARCHAR(100)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#243b53">baseline_start</FONT> <FONT COLOR="#829ab1" POINT-SIZE="8">DATE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#243b53">baseline_end</FONT> <FONT COLOR="#829ab1" POINT-SIZE="8">DATE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#243b53">created_at</FONT> <FONT COLOR="#829ab1" POINT-SIZE="8">TIMESTAMPTZ</FONT></TD></TR></TABLE> >];
scenario_change [label=< <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD ALIGN="LEFT" BGCOLOR="#0f766e"><FONT COLOR="white" POINT-SIZE="11"><B>scenario_change</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#0f766e"><B>PK</B>&nbsp;id</FONT> <FONT COLOR="#829ab1" POINT-SIZE="8">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#0f766e"><B>FK</B>&nbsp;scenario_id</FONT> <FONT COLOR="#829ab1" POINT-SIZE="8">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#243b53">change_type</FONT> <FONT COLOR="#829ab1" POINT-SIZE="8">VARCHAR(32)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#0f766e"><B>FK</B>&nbsp;target_activity_record_id</FONT> <FONT COLOR="#829ab1" POINT-SIZE="8">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#0f766e"><B>FK</B>&nbsp;target_appliance_usage_id</FONT> <FONT COLOR="#829ab1" POINT-SIZE="8">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#243b53">change_value</FONT> <FONT COLOR="#829ab1" POINT-SIZE="8">NUMERIC(5,2)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#243b53">FOREIGN</FONT> <FONT COLOR="#829ab1" POINT-SIZE="8">KEY</FONT></TD></TR></TABLE> >];
scenario_result [label=< <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD ALIGN="LEFT" BGCOLOR="#0f766e"><FONT COLOR="white" POINT-SIZE="11"><B>scenario_result</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#0f766e"><B>PK</B>&nbsp;id</FONT> <FONT COLOR="#829ab1" POINT-SIZE="8">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#0f766e"><B>FK</B>&nbsp;scenario_id</FONT> <FONT COLOR="#829ab1" POINT-SIZE="8">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#243b53">baseline_kg_co2e</FONT> <FONT COLOR="#829ab1" POINT-SIZE="8">NUMERIC(24,6)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#243b53">scenario_kg_co2e</FONT> <FONT COLOR="#829ab1" POINT-SIZE="8">NUMERIC(24,6)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#243b53">reduction_kg_co2e</FONT> <FONT COLOR="#829ab1" POINT-SIZE="8">NUMERIC(24,6)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#243b53">calculated_at</FONT> <FONT COLOR="#829ab1" POINT-SIZE="8">TIMESTAMPTZ</FONT></TD></TR></TABLE> >];
recommendation [label=< <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD ALIGN="LEFT" BGCOLOR="#0f766e"><FONT COLOR="white" POINT-SIZE="11"><B>recommendation</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#0f766e"><B>PK</B>&nbsp;id</FONT> <FONT COLOR="#829ab1" POINT-SIZE="8">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#0f766e"><B>FK</B>&nbsp;scenario_result_id</FONT> <FONT COLOR="#829ab1" POINT-SIZE="8">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#243b53">title</FONT> <FONT COLOR="#829ab1" POINT-SIZE="8">VARCHAR(150)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#243b53">description</FONT> <FONT COLOR="#829ab1" POINT-SIZE="8">TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#243b53">target_category</FONT> <FONT COLOR="#829ab1" POINT-SIZE="8">VARCHAR(16)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#243b53">recommended_action</FONT> <FONT COLOR="#829ab1" POINT-SIZE="8">TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#243b53">estimated_reduction_kg_co2e</FONT> <FONT COLOR="#829ab1" POINT-SIZE="8">NUMERIC(24,6)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#243b53">priority</FONT> <FONT COLOR="#829ab1" POINT-SIZE="8">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#243b53">created_at</FONT> <FONT COLOR="#829ab1" POINT-SIZE="8">TIMESTAMPTZ</FONT></TD></TR></TABLE> >];
}
user_profile -> vehicle [dir=both, arrowtail=tee, arrowhead=crow, taillabel="1", headlabel="0..*"];
user_profile -> activity_record [dir=both, arrowtail=tee, arrowhead=crow, taillabel="1", headlabel="0..*"];
user_profile -> scenario [dir=both, arrowtail=tee, arrowhead=crow, taillabel="1", headlabel="0..*"];
vehicle -> vehicle_monthly_input [dir=both, arrowtail=tee, arrowhead=crow, taillabel="1", headlabel="0..*"];
vehicle -> mobility_activity [dir=both, arrowtail=tee, arrowhead=crow, taillabel="1", headlabel="0..*"];
vehicle -> fuel_purchase_activity [dir=both, arrowtail=tee, arrowhead=crow, taillabel="1", headlabel="0..*"];
activity_record -> mobility_activity [dir=both, arrowtail=tee, arrowhead=crow, taillabel="1", headlabel="0..1"];
activity_record -> fuel_purchase_activity [dir=both, arrowtail=tee, arrowhead=crow, taillabel="1", headlabel="0..1"];
activity_record -> electricity_usage [dir=both, arrowtail=tee, arrowhead=crow, taillabel="1", headlabel="0..1"];
electricity_usage -> appliance_usage [dir=both, arrowtail=tee, arrowhead=crow, taillabel="1", headlabel="0..*"];
activity_record -> emission_calculation [dir=both, arrowtail=tee, arrowhead=crow, taillabel="1", headlabel="0..1"];
emission_factor -> emission_calculation [dir=both, arrowtail=tee, arrowhead=crow, taillabel="1", headlabel="0..*"];
scenario -> scenario_change [dir=both, arrowtail=tee, arrowhead=crow, taillabel="1", headlabel="0..*"];
activity_record -> scenario_change [dir=both, arrowtail=tee, arrowhead=crow, taillabel="1", headlabel="0..*"];
appliance_usage -> scenario_change [dir=both, arrowtail=tee, arrowhead=crow, taillabel="0..1", headlabel="0..*"];
scenario -> scenario_result [dir=both, arrowtail=tee, arrowhead=crow, taillabel="1", headlabel="0..1"];
scenario_result -> recommendation [dir=both, arrowtail=tee, arrowhead=crow, taillabel="1", headlabel="0..*"];
}
