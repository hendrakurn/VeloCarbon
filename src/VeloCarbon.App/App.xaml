<Application x:Class="VeloCarbon.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="Accent" Color="#145A42"/>
        <SolidColorBrush x:Key="AccentLight" Color="#E2F0E8"/>
        <SolidColorBrush x:Key="Muted" Color="#526660"/>
        <SolidColorBrush x:Key="ErrorBrush" Color="#C62828"/>

        <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/></Style>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/><Setter Property="Foreground" Value="{StaticResource Accent}"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style TargetType="TextBox"><Setter Property="Background" Value="#EDF3EF"/><Setter Property="BorderBrush" Value="#A6BAB0"/><Setter Property="Padding" Value="7,4"/><Setter Property="Margin" Value="0,2,0,6"/></Style>
        <Style TargetType="ComboBox"><Setter Property="Padding" Value="4"/><Setter Property="Margin" Value="0,2,0,6"/></Style>
        <Style TargetType="DatePicker"><Setter Property="Margin" Value="0,2,0,6"/></Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,6"/><Setter Property="Margin" Value="0,4,8,4"/>
            <Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter RecognizesAccessKey="True"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="#4E8F77"/>
                                <Setter TargetName="ButtonSurface" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.48"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#E6EEEA"/><Setter Property="Foreground" Value="Black"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="HeadersVisibility" Value="Column"/><Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="CanUserAddRows" Value="False"/><Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CFD8DC"/>
        </Style>
        <Style x:Key="Surface" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Effect"><Setter.Value><DropShadowEffect ShadowDepth="2" BlurRadius="12" Opacity="0.09" Color="#183A26" Direction="270"/></Setter.Value></Setter>
        </Style>
        <Style x:Key="MethodTabs" TargetType="TabControl">
            <Setter Property="ItemContainerStyle">
                <Setter.Value><Style TargetType="TabItem">
                    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
                        <Border x:Name="Method" Background="White" CornerRadius="8" Padding="16,11" Margin="0,0,8,0">
                            <ContentPresenter x:Name="MethodLabel" ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Method" Property="Background" Value="#E2F0E8"/></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Method" Property="Background" Value="#145A42"/><Setter TargetName="MethodLabel" Property="TextElement.Foreground" Value="White"/><Setter TargetName="MethodLabel" Property="TextElement.FontWeight" Value="SemiBold"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Method" Property="BorderBrush" Value="#176349"/><Setter TargetName="Method" Property="BorderThickness" Value="1"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate></Setter.Value></Setter>
                </Style></Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
