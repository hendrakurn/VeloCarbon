<Window x:Class="VeloCarbon.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VeloCarbon Modern - Jejak Karbon Mobilitas &amp; Listrik" Width="1160" Height="800" MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="#EEF1EF" FontFamily="Inter, Segoe UI" Foreground="#17302A">
    <DockPanel>
        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#CFD8DC" BorderThickness="0,1,0,0" Padding="12,6">
            <TextBlock Text="{Binding Shell.StatusText}" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                        <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                        <Style.Triggers><DataTrigger Binding="{Binding Shell.IsError}" Value="True"><Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/></DataTrigger></Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>

        <Border DockPanel.Dock="Left" Width="192" Margin="12" Style="{StaticResource Surface}" Padding="12">
            <DockPanel>
                <Image DockPanel.Dock="Top" Source="Assets/velocarbon-logo.png" Width="150" Height="54" Stretch="Uniform" AutomationProperties.Name="VeloCarbon"/>
                <Button DockPanel.Dock="Bottom" Content="↪  Logout" Style="{StaticResource SecondaryButton}" Click="Exit_Click" HorizontalContentAlignment="Left" ToolTip="Tutup aplikasi"/>
                <StackPanel>
                    <TextBlock Text="MENU" FontSize="11" Foreground="{StaticResource Muted}" Margin="9,20,0,10"/>
                    <ListBox SelectedIndex="{Binding SelectedIndex, ElementName=MainTabs, Mode=TwoWay}" BorderThickness="0" Background="Transparent" AutomationProperties.Name="Navigasi utama">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Foreground" Value="#405950"/>
                                <Setter Property="Template">
                                    <Setter.Value><ControlTemplate TargetType="ListBoxItem">
                                        <Grid Margin="0,2">
                                            <Border x:Name="NavBackground" Background="Transparent" CornerRadius="8"/>
                                            <Border x:Name="Marker" Width="4" Height="24" HorizontalAlignment="Left" Background="Transparent" CornerRadius="2"/>
                                            <ContentPresenter Margin="12,10" VerticalAlignment="Center"/>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavBackground" Property="Background" Value="#EDF4EF"/></Trigger>
                                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="NavBackground" Property="Background" Value="#E1EFE6"/><Setter TargetName="Marker" Property="Background" Value="#176349"/><Setter Property="Foreground" Value="#145A42"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="NavBackground" Property="BorderBrush" Value="#176349"/><Setter TargetName="NavBackground" Property="BorderThickness" Value="1"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate></Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE80F;" Width="24"/><TextBlock Text="Dashboard"/></StackPanel>
                        <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE70F;" Width="24"/><TextBlock Text="Input Aktivitas"/></StackPanel>
                        <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE81C;" Width="24"/><TextBlock Text="Riwayat"/></StackPanel>
                        <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE9E9;" Width="24"/><TextBlock Text="Simulasi"/></StackPanel>
                        <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE9D9;" Width="24"/><TextBlock Text="Faktor Emisi"/></StackPanel>
                        <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE77B;" Width="24"/><TextBlock Text="Profil &amp; Kendaraan"/></StackPanel>
                    </ListBox>
                </StackPanel>
            </DockPanel>
        </Border>
        <DockPanel Margin="6,12,18,12">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,14">
                <Border Style="{StaticResource Surface}" Width="224" Height="48" Margin="0,0,12,0" Padding="12,4">
                    <DockPanel><TextBlock DockPanel.Dock="Left" FontFamily="Segoe MDL2 Assets" Text="&#xE787;" Margin="0,0,8,0"/>
                        <ComboBox ItemsSource="{Binding Months}" SelectedItem="{Binding Shell.SelectedMonth}" AutomationProperties.Name="Bulan" Margin="0" VerticalAlignment="Center">
                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding StringFormat='{}{0:MMMM yyyy}'}"/></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Surface}" Width="224" Height="48" Padding="12,4">
                    <DockPanel><Border DockPanel.Dock="Left" Width="30" Height="30" Background="#E2F0E8" CornerRadius="15" Margin="0,0,8,0"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE77B;" HorizontalAlignment="Center"/></Border>
                        <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding Shell.SelectedProfile}" DisplayMemberPath="Name" AutomationProperties.Name="Profil aktif" Margin="0" VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>
            </StackPanel>
            <TabControl x:Name="MainTabs" SelectedIndex="0" Background="Transparent">
                <TabControl.Template><ControlTemplate TargetType="TabControl"><ContentPresenter ContentSource="SelectedContent"/></ControlTemplate></TabControl.Template>
            <!-- DASHBOARD -->
            <TabItem Header="Dashboard">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="4,0,10,12">
                        <DockPanel Margin="0,0,0,12">
                            <Button DockPanel.Dock="Right" Content="+  Catat aktivitas" Click="AddActivity_Click" VerticalAlignment="Center"/>
                            <StackPanel><TextBlock Text="Dashboard" FontSize="32" FontWeight="Bold"/>
                                <TextBlock Text="Ringkasan emisi mobilitas dan listrik" Style="{StaticResource Hint}"/></StackPanel>
                        </DockPanel>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Surface}" Padding="16" Margin="0,0,8,0">
                                <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#123B2D"/><GradientStop Color="#24764F" Offset="1"/></LinearGradientBrush></Border.Background>
                                <StackPanel><TextBlock Text="Total emisi" Foreground="#E1F1E7"/>
                                    <TextBlock Text="{Binding Dashboard.TotalText}" Foreground="White" FontSize="25" FontWeight="Bold" Margin="0,8"/>
                                    <TextBlock Text="{Binding Dashboard.TopSource, StringFormat='Sumber terbesar: {0}'}" Foreground="#E1F1E7" TextWrapping="Wrap"/></StackPanel>
                            </Border>
                            <ItemsControl Grid.Column="1" ItemsSource="{Binding Dashboard.Categories}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate><DataTemplate>
                                    <Border Style="{StaticResource Surface}" Padding="14" Margin="4,0,4,0" MinHeight="108">
                                        <StackPanel><TextBlock Text="{Binding Label}" TextWrapping="Wrap" Style="{StaticResource Hint}"/>
                                            <TextBlock Text="{Binding KgText}" FontWeight="Bold" FontSize="20" Margin="0,8"/>
                                            <TextBlock Text="{Binding ShareText, StringFormat='{}{0} dari total'}" Style="{StaticResource Hint}"/></StackPanel>
                                    </Border>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.55*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Surface}" Padding="18" Margin="0,0,12,0">
                                <StackPanel><TextBlock Text="Tren 6 bulan" Style="{StaticResource Heading}"/>
                                    <ItemsControl ItemsSource="{Binding Dashboard.Trend}" Margin="0,12,0,0">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate><DataTemplate>
                                            <StackPanel VerticalAlignment="Bottom" Margin="2,0">
                                                <TextBlock Text="{Binding KgText}" FontSize="10" HorizontalAlignment="Center"/>
                                                <Border Height="{Binding BarHeight}" Background="{StaticResource Accent}" CornerRadius="4,4,0,0" Width="28" Margin="0,4"/>
                                                <TextBlock Text="{Binding Month}" HorizontalAlignment="Center" Foreground="{StaticResource Muted}"/>
                                            </StackPanel>
                                        </DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource Surface}" Padding="18">
                                <StackPanel><TextBlock Text="Kontribusi emisi" Style="{StaticResource Heading}"/>
                                    <TextBlock Text="Belum ada aktivitas pada bulan ini.">
                                        <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Hint}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Dashboard.IsEmpty}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                    <ItemsControl ItemsSource="{Binding Dashboard.Categories}"><ItemsControl.ItemTemplate><DataTemplate>
                                        <StackPanel Margin="0,6,0,4">
                                            <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding ShareText}" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding Label}"/></DockPanel>
                                            <ProgressBar Minimum="0" Maximum="320" Value="{Binding BarWidth, Mode=OneWay}" Foreground="{StaticResource Accent}" Height="6" Margin="0,5"/>
                                            <TextBlock Text="{Binding KgText}" Style="{StaticResource Hint}"/>
                                        </StackPanel>
                                    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <TextBlock Text="Estimasi edukatif berdasarkan catatan mobilitas dan listrik." Style="{StaticResource Hint}" Margin="0,16,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <!-- INPUT AKTIVITAS -->
            <TabItem Header="Input Aktivitas">
                <DockPanel Margin="4,0,10,0"><StackPanel DockPanel.Dock="Top" Margin="0,0,0,16"><TextBlock Text="Input Aktivitas" FontSize="32" FontWeight="Bold"/><TextBlock Text="Pilih metode pencatatan untuk aktivitasmu." Style="{StaticResource Hint}"/></StackPanel><TabControl BorderThickness="0" Background="Transparent" Margin="0,0,0,4" Style="{StaticResource MethodTabs}">
                    <TabItem Header="Jarak perjalanan"><ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="2,0,10,8"><Grid.ColumnDefinitions><ColumnDefinition Width="1.65*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource Surface}" Padding="22" Margin="0,12,0,0"><StackPanel MaxWidth="540" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource Heading}" Text="Catat perjalanan"/>
                        <TextBlock Text="Moda"/><ComboBox ItemsSource="{Binding Input.Modes}" SelectedItem="{Binding Input.Mode}"/>
                        <TextBlock Text="Kendaraan (wajib untuk Car/Motorcycle)"/><ComboBox ItemsSource="{Binding Input.Vehicles}" SelectedItem="{Binding Input.DistanceVehicle}" DisplayMemberPath="Name"/>
                        <TextBlock Text="Tanggal"/><DatePicker SelectedDate="{Binding Input.DistanceDate}"/>
                        <TextBlock Text="Jarak per perjalanan satu arah (km)"/><TextBox Text="{Binding Input.DistanceKm, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="Frekuensi (jumlah perjalanan pada tanggal itu)"/><TextBox Text="{Binding Input.Frequency, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Content="Simpan perjalanan" Command="{Binding Input.SaveDistanceCommand}" HorizontalAlignment="Left"/>
                    </StackPanel></Border>
                    <StackPanel Grid.Column="1" Margin="12,12,0,0">
                        <Border Style="{StaticResource Surface}" Background="#154534" Padding="18">
                            <StackPanel><TextBlock Text="Pratinjau emisi" Foreground="#D4EADF" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Input.DistancePreview}" Foreground="White" FontSize="26" FontWeight="Bold" TextWrapping="Wrap" Margin="0,10"/>
                                <TextBlock Text="{Binding Input.DistancePreviewDetails}" Foreground="#D4EADF" TextWrapping="Wrap"/></StackPanel>
                        </Border>
                        <Border Style="{StaticResource Surface}" Padding="18" Margin="0,12,0,0"><StackPanel>
                            <TextBlock Text="Satu metode tiap bulan" FontWeight="SemiBold"/>
                            <TextBlock Text="Untuk kendaraan yang sama, pilih jarak atau BBM dalam satu bulan." TextWrapping="Wrap" Style="{StaticResource Hint}" Margin="0,6,0,0"/>
                        </StackPanel></Border>
                    </StackPanel>
                </Grid></ScrollViewer></TabItem>
                    <TabItem Header="Pembelian BBM"><Border Style="{StaticResource Surface}" Padding="22" Margin="0,12,0,0"><StackPanel MaxWidth="540" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource Heading}" Text="Catat pembelian bahan bakar"/>
                        <TextBlock Text="Kendaraan (jenis BBM mengikuti kendaraan)"/><ComboBox ItemsSource="{Binding Input.Vehicles}" SelectedItem="{Binding Input.FuelVehicle}" DisplayMemberPath="Name"/>
                        <TextBlock Text="Tanggal pembelian"/><DatePicker SelectedDate="{Binding Input.FuelDate}"/>
                        <TextBlock Text="Liter dibeli"/><TextBox Text="{Binding Input.Liters}"/>
                        <TextBlock Text="Total biaya (opsional)"/><TextBox Text="{Binding Input.TotalCost}"/>
                        <TextBlock Style="{StaticResource Hint}" Text="Catatan: pembelian BBM adalah pendekatan estimasi, bukan BBM yang terbakar pada bulan itu. Satu kendaraan hanya boleh memakai satu metode (jarak ATAU BBM) per bulan." Margin="0,0,0,6"/>
                        <Button Content="Simpan pembelian" Command="{Binding Input.SaveFuelCommand}" HorizontalAlignment="Left"/>
                    </StackPanel></Border></TabItem>
                    <TabItem Header="Meter listrik"><Border Style="{StaticResource Surface}" Padding="22" Margin="0,12,0,0"><StackPanel MaxWidth="540" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource Heading}" Text="Catat total kWh meter"/>
                        <TextBlock Text="Periode: bulan yang dipilih di bagian atas" Style="{StaticResource Hint}" Margin="0,0,0,6"/>
                        <TextBlock Text="Total pemakaian (kWh)"/><TextBox Text="{Binding Input.Kwh}"/>
                        <Button Content="Simpan listrik" Command="{Binding Input.SaveMeterCommand}" HorizontalAlignment="Left"/>
                    </StackPanel></Border></TabItem>
                    <TabItem Header="Estimasi alat"><DockPanel Margin="16">
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Heading}" Text="Estimasi listrik dari alat elektronik"/>
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,0,0,6"
                                   Text="Klik sel untuk mengisi. kWh = watt / 1000 × jumlah × jam per hari × hari pakai. Mengasumsikan daya rata-rata tetap; hasil dapat berbeda dari meter."/>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal">
                            <Button Content="+ Tambah alat" Command="{Binding Input.AddApplianceCommand}" Style="{StaticResource SecondaryButton}"/>
                            <Button Content="Hapus alat terpilih" Command="{Binding Input.RemoveApplianceCommand}" Style="{StaticResource SecondaryButton}"/>
                            <Button Content="Simpan listrik (alat)" Command="{Binding Input.SaveAppliancesCommand}"/>
                        </StackPanel>
                        <DataGrid ItemsSource="{Binding Input.Appliances}" SelectedItem="{Binding Input.SelectedAppliance}" IsReadOnly="False" CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Nama alat" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="2*"/>
                                <DataGridTextColumn Header="Daya (watt)" Binding="{Binding PowerWatt, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                <DataGridTextColumn Header="Jumlah" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                <DataGridTextColumn Header="Jam / hari" Binding="{Binding HoursPerDay, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                <DataGridTextColumn Header="Hari pakai" Binding="{Binding DaysUsed, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel></TabItem>
                </TabControl></DockPanel>
            </TabItem>

            <!-- RIWAYAT -->
            <TabItem Header="Riwayat"><DockPanel Margin="4,0,10,10"><StackPanel DockPanel.Dock="Top" Margin="0,0,0,12"><TextBlock Text="Riwayat" FontSize="32" FontWeight="Bold"/><TextBlock Text="Catatan aktivitas dan estimasi emisi untuk bulan terpilih." Style="{StaticResource Hint}"/></StackPanel>
                <Border Style="{StaticResource Surface}" Padding="20" Margin="4,2,10,10"><DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Heading}" Text="Aktivitas bulan terpilih"/>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal">
                        <Button Content="Hapus terpilih" Command="{Binding History.DeleteCommand}" Background="{StaticResource ErrorBrush}"/>
                        <TextBlock Style="{StaticResource Hint}" Text="Untuk mengganti metode input (mis. jarak → BBM), hapus catatan lama agar tidak terhitung ganda." VerticalAlignment="Center"/>
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding History.Rows}" SelectedItem="{Binding History.Selected}" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tanggal" Binding="{Binding Date}" Width="110"/>
                            <DataGridTextColumn Header="Aktivitas" Binding="{Binding Label}" Width="2*"/>
                            <DataGridTextColumn Header="Nilai" Binding="{Binding Value}" Width="*"/>
                            <DataGridTextColumn Header="Emisi" Binding="{Binding Kg}" Width="*"/>
                            <DataGridTextColumn Header="Faktor (versi, nilai)" Binding="{Binding Source}" Width="1.5*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel></Border>
            </DockPanel></TabItem>

            <!-- SIMULASI -->
            <TabItem Header="Simulasi"><DockPanel Margin="4,0,10,10"><StackPanel DockPanel.Dock="Top" Margin="0,0,0,12"><TextBlock Text="Simulasi" FontSize="32" FontWeight="Bold"/><TextBlock Text="Bandingkan emisi awal dengan perubahan kebiasaan." Style="{StaticResource Hint}"/></StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12">
                    <TextBlock Style="{StaticResource Heading}" Text="Simulasi perubahan kebiasaan"/>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8" Text="Pilih target, tentukan persentase pengurangan, tambahkan ke skenario, lalu jalankan. Simulasi tidak mengubah data aktivitas asli."/>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <ComboBox ItemsSource="{Binding Simulation.Targets}" SelectedItem="{Binding Simulation.SelectedTarget}" DisplayMemberPath="Display"/>
                        <TextBox Grid.Column="1" Text="{Binding Simulation.Percent}" Margin="8,2,0,6" ToolTip="Persentase pengurangan"/>
                        <Button Grid.Column="2" Content="+ Tambah perubahan (%)" Command="{Binding Simulation.AddChangeCommand}" Margin="8,4,0,4"/>
                    </Grid>
                    <ListBox ItemsSource="{Binding Simulation.Changes}" SelectedItem="{Binding Simulation.SelectedChange}" DisplayMemberPath="Display" MinHeight="70" MaxHeight="140" Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Nama skenario: "/><TextBox Text="{Binding Simulation.ScenarioName}" Width="220" Margin="0,2,12,6"/>
                        <Button Content="Hapus perubahan terpilih" Command="{Binding Simulation.RemoveChangeCommand}" Style="{StaticResource SecondaryButton}"/>
                        <Button Content="Jalankan simulasi" Command="{Binding Simulation.RunCommand}"/>
                    </StackPanel>
                    <Border Background="{StaticResource AccentLight}" Padding="12" Margin="0,8,0,8">
                        <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers><DataTrigger Binding="{Binding Simulation.HasResult}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal"><TextBlock Text="Kondisi awal: " Width="130"/><TextBlock Text="{Binding Simulation.BaselineText}" FontWeight="SemiBold"/></StackPanel>
                            <StackPanel Orientation="Horizontal"><TextBlock Text="Dengan skenario: " Width="130"/><TextBlock Text="{Binding Simulation.ScenarioText}" FontWeight="SemiBold"/></StackPanel>
                            <StackPanel Orientation="Horizontal"><TextBlock Text="Pengurangan: " Width="130"/><TextBlock Text="{Binding Simulation.ReductionText}" FontWeight="Bold" Foreground="{StaticResource Accent}"/><TextBlock Text=" ("/><TextBlock Text="{Binding Simulation.PercentText}"/><TextBlock Text=")"/></StackPanel>
                        </StackPanel>
                    </Border>
                    <TextBlock Style="{StaticResource Heading}" Text="Rekomendasi (urut dampak)"/>
                    <DataGrid ItemsSource="{Binding Simulation.Recommendations}" MaxHeight="170" Margin="0,0,0,12">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Priority}" Width="40"/>
                            <DataGridTextColumn Header="Target" Binding="{Binding Title}" Width="1.5*"/>
                            <DataGridTextColumn Header="Aksi yang disarankan" Binding="{Binding Action}" Width="3*"/>
                            <DataGridTextColumn Header="Estimasi pengurangan" Binding="{Binding Reduction}" Width="1.2*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Style="{StaticResource Heading}" Text="Skenario tersimpan"/>
                    <DataGrid ItemsSource="{Binding Simulation.Past}" MaxHeight="170">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nama" Binding="{Binding Name}" Width="2*"/>
                            <DataGridTextColumn Header="Bulan" Binding="{Binding Month}" Width="*"/>
                            <DataGridTextColumn Header="Awal" Binding="{Binding Baseline}" Width="*"/>
                            <DataGridTextColumn Header="Skenario" Binding="{Binding ScenarioValue}" Width="*"/>
                            <DataGridTextColumn Header="Pengurangan" Binding="{Binding Reduction}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel></ScrollViewer>
            </DockPanel></TabItem>

            <!-- FAKTOR EMISI -->
            <TabItem Header="Faktor Emisi"><DockPanel Margin="4,0,10,10"><StackPanel DockPanel.Dock="Top" Margin="0,0,0,12"><TextBlock Text="Faktor Emisi" FontSize="32" FontWeight="Bold"/><TextBlock Text="Nilai, versi, masa berlaku, dan sumber perhitungan." Style="{StaticResource Hint}"/></StackPanel>
                <Border Style="{StaticResource Surface}" Padding="20" Margin="4,2,10,10"><DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Heading}" Text="Faktor emisi yang dipakai (dapat ditelusuri: sumber, satuan, versi)"/>
                    <DataGrid ItemsSource="{Binding Factors.Rows}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Kategori" Binding="{Binding Category}" Width="90"/>
                            <DataGridTextColumn Header="Sub" Binding="{Binding Subcategory}" Width="100"/>
                            <DataGridTextColumn Header="Nilai" Binding="{Binding Value}" Width="70"/>
                            <DataGridTextColumn Header="Satuan" Binding="{Binding Unit}" Width="110"/>
                            <DataGridTextColumn Header="Versi" Binding="{Binding Version}" Width="70"/>
                            <DataGridTextColumn Header="Berlaku" Binding="{Binding Validity}" Width="190"/>
                            <DataGridTextColumn Header="Sumber" Binding="{Binding Source}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel></Border>
            </DockPanel></TabItem>

            <!-- PROFIL -->
            <TabItem Header="Profil &amp; Kendaraan"><DockPanel Margin="4,0,10,10"><StackPanel DockPanel.Dock="Top" Margin="0,0,0,12"><TextBlock Text="Profil &amp; Kendaraan" FontSize="32" FontWeight="Bold"/><TextBlock Text="Kelola profil dan kendaraan untuk pencatatan aktivitas." Style="{StaticResource Hint}"/></StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto"><Grid VerticalAlignment="Top" Margin="0,1,8,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="1.3*"/></Grid.ColumnDefinitions><Border Style="{StaticResource Surface}" Padding="22" VerticalAlignment="Top" Margin="0,0,12,0"><StackPanel>
                    <TextBlock Style="{StaticResource Heading}" Text="Profil baru"/>
                    <TextBox Text="{Binding NewProfileName, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Content="Buat profil" Command="{Binding CreateProfileCommand}" HorizontalAlignment="Left"/>
                    </StackPanel></Border><Border Grid.Column="1" Style="{StaticResource Surface}" Padding="22"><StackPanel><TextBlock Style="{StaticResource Heading}" Text="Tambah kendaraan"/>
                    <TextBlock Text="Nama kendaraan"/><TextBox Text="{Binding NewVehicleName, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Tipe"/><ComboBox ItemsSource="{Binding VehicleTypes}" SelectedItem="{Binding NewVehicleType}"/>
                    <TextBlock Text="Bahan bakar"/><ComboBox ItemsSource="{Binding FuelTypes}" SelectedItem="{Binding NewVehicleFuel}"/>
                    <Button Content="Tambah kendaraan" Command="{Binding AddVehicleCommand}" HorizontalAlignment="Left"/>
                </StackPanel></Border>
            </Grid></ScrollViewer></DockPanel></TabItem>
            </TabControl>
        </DockPanel>
    </DockPanel>
</Window>
